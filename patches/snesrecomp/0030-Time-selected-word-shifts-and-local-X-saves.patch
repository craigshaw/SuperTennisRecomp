 runner/src/snes/aot_bus_timing.h              |   6 +
 tests/run_c_tests.sh                          |   1 +
 .../test_subtract_rmw_instruction_timing.py   |   2 +-
 tests/timing/test_word_instruction_timing.py  | 109 ++++++++++++++++++
 5 files changed, 139 insertions(+), 6 deletions(-)
 create mode 100644 tests/timing/test_word_instruction_timing.py

diff --git a/recompiler/v2/bus_timing.py b/recompiler/v2/bus_timing.py
