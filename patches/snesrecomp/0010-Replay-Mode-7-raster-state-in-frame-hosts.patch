     case 0x212C: case 0x212E:    /* TM / TMW */
     case 0x2131:                 /* CGADSUB */
     /* HDMAEN is a per-line fact as much as any PPU register. This title
@@ -2368,33 +2379,52 @@ static int raster_reg_journaled(uint16_t reg) {
 void ppu_rasterBegin(Ppu *ppu) {
   s_raster_count = 0;
   s_raster_next = 0;
-  s_raster_armed = 1;
