+                          "raster split updates shared BG1 and Mode 7 scroll");
+        failures += check(ppu->screenEnabled[0] == 0x13,
+                          "raster split restores bottom-band layers");
+    }
+
     ppu_free(ppu);
     if (failures) return 1;
     puts("ppu_sprite_limit_test: PASS");
