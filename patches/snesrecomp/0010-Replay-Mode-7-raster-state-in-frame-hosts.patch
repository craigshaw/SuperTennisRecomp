+    /* A frame-model host must restore every part of a Mode 7 to Mode 1 raster
+     * split, including the Mode 7 copies of the shared BG1 scroll registers. */
+    {
+        ppu_reset(ppu);
+        ppu->bgmode = 1;
+        ppu->bgXsc[0] = 0x48;
+        ppu->bgTileAdr = 0x0555;
