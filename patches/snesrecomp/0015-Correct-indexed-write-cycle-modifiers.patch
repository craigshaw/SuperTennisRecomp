diff --git a/tests/test_snes_cycles.py b/tests/test_snes_cycles.py
--- a/tests/test_snes_cycles.py
+++ b/tests/test_snes_cycles.py
@@ -121,6 +121,9 @@
     assert _cyc(0xB1, index_page_cross=True) == 6   # LDA (dp),Y read +1
